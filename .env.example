# GEMINI_API_KEY: Required for Gemini AI API calls (Server-side secret).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# Notion Integration Settings (Optional)
# Server-side Notion Integration Token (starts with ntn_ or secret_)
NOTION_TOKEN=""

# Server-side Notion Database IDs
NOTION_QUESTION_DB_ID=""
NOTION_ANSWER_DB_ID=""

# Client-side Frontend Notion Settings (Prefix with VITE_ for Vite bundling)
VITE_NOTION_TOKEN=""
VITE_NOTION_QUESTION_DB_ID=""
VITE_NOTION_ANSWER_DB_ID=""

# Firebase Web App Configuration (GitHub Repository Variables / Client Env)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
