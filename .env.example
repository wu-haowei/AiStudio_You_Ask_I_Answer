# GEMINI_API_KEY: Required for Gemini AI API calls (Server-side secret).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# Firebase Web App Configuration (GitHub Repository Variables / Client Env)
# All application data — Q&A content, rooms and chat history — is stored in Firestore.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# VITE_GOOGLE_API_KEY: Google Cloud API key restricted to the Drive API.
# Lets the admin screen read publicly-shared Drive files/folders to bulk-import
# questions. Optional — the "從 Google 雲端匯入" button just shows an error
# without it. See SETUP.md for how to create the key.
VITE_GOOGLE_API_KEY=""

# VITE_GOOGLE_API_URL: Default Google Drive file/folder link the import modal
# pre-fills its input with. Optional — just saves retyping the usual folder link.
VITE_GOOGLE_API_URL=""
