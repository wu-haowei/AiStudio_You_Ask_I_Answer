rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * There is no backend, so these rules are the only place anything can be
     * enforced. Two ideas do all the work:
     *
     *   1. A password is proven by writing a hash into sessions/{uid}. The rule
     *      compares it against secrets/{key}, which no client may read, so a
     *      wrong password is refused by Firestore rather than by app code that
     *      devtools could step over.
     *
     *   2. Everything else asks "which name does this uid belong to?" by
     *      reading that session document. A pair's room, chat history and
     *      question library are readable only by the two names in it.
     */

    /* ---------------------------------------------------------------- *
     * Invite gate — controls who may create an account
     * ---------------------------------------------------------------- */

    function inviteRequired() {
      return exists(/databases/$(database)/documents/config/access)
        && get(/databases/$(database)/documents/config/access).data.requireInvite == true;
    }

    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    /** With the gate off anyone may register; with it on, only allowlisted devices. */
    function canRegister() {
      return request.auth != null && (!inviteRequired() || isMember());
    }

    function inviteCode() {
      return get(/databases/$(database)/documents/config/invite).data.code;
    }

    /* ---------------------------------------------------------------- *
     * Session helpers
     * ---------------------------------------------------------------- */

    function hasSession() {
      return request.auth != null
        && exists(/databases/$(database)/documents/sessions/$(request.auth.uid));
    }

    /** The signed-in display name. Only call this when hasSession() is true. */
    function me() {
      return get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.name;
    }

    /** Lowercased form of the same name — names are case-insensitive. */
    function myKey() {
      return me().lower();
    }

    /**
     * True once a request has proven, via Firebase's own verified-email
     * sign-in, that it is entitled to reset a particular account's secret —
     * the "forgot password" path in through the front door instead of a
     * session, which someone who forgot their password does not have yet.
     * See emails/{emailKey} below for the mapping this reads.
     */
    function canResetByEmail(key) {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/emails/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/emails/$(request.auth.token.email.lower())).data.key == key;
    }

    /* ---------------------------------------------------------------- *
     * Accounts
     * ---------------------------------------------------------------- */

    match /members/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.code is string
        && request.resource.data.code == inviteCode();
      allow update, delete: if false;
    }

    match /config/{document} {
      // The app needs to see whether the gate is on...
      allow read: if document == 'access';
      // ...but the invite code itself stays server-side only.
      allow write: if false;
    }

    /*
     * Public account record. Readable so the login screen can say "this name is
     * new, use the default password", and so the rules below can confirm that a
     * name and its document key belong together.
     */
    match /users/{key} {
      allow read: if true;
      /*
       * The id is the lowercased name. Enforcing that here is what keeps
       * "Amy" and "amy" one account — and stops a session being bound to one
       * person's name using another person's secret.
       */
      allow create: if canRegister() && request.resource.data.name.lower() == key;
      // Only the owner may touch it afterwards, and never rename it
      allow update: if hasSession()
        && myKey() == key
        && request.resource.data.name.lower() == key;
      allow delete: if false;
    }

    /*
     * Password hashes. Never readable by anyone — the whole scheme depends on
     * that, since a readable hash is a hash an attacker can replay.
     */
    match /secrets/{key} {
      allow read: if false;
      // Claiming a name is a one-off; `create` only ever applies to a document
      // that does not exist yet, so a password cannot be overwritten this way
      allow create: if canRegister();
      allow update: if (hasSession() && myKey() == key) || canResetByEmail(key);
      allow delete: if false;
    }

    /*
     * Recovery email → account key, so "forgot password" has something to
     * reset without a session (the whole problem a forgotten password causes).
     *
     * The email/password sign-in this depends on is Firebase's own — sending
     * the actual reset mail is Firebase's job, not this app's, so there is no
     * mail-sending package or server of ours anywhere in this path. Completing
     * that flow is what sets request.auth.token.email_verified, which is what
     * canResetByEmail (above) actually trusts.
     */
    match /emails/{emailKey} {
      // Only readable by someone who has just proven, via a verified Firebase
      // email/password sign-in, that this exact address is theirs.
      allow read: if request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == emailKey;
      // Claiming an email is a one-off per address, same reasoning as secrets
      // above — this is what stops two names from fighting over one inbox.
      allow create: if hasSession() && request.resource.data.key == myKey();
      allow update: if false;
      allow delete: if hasSession() && resource.data.key == myKey();
    }

    /*
     * The proof of identity. Writing this document IS the password check: the
     * submitted hash must match the stored secret, and the name must match the
     * one recorded under that key.
     */
    match /sessions/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.name is string
        // `key` is carried in the document because a path segment has to be a
        // plain value; it is checked against the name rather than trusted
        && request.resource.data.key == request.resource.data.name.lower()
        && get(/databases/$(database)/documents/secrets/$(request.resource.data.key)).data.passwordHash
             == request.resource.data.passwordHash;
    }

    /* ---------------------------------------------------------------- *
     * Finding someone to talk to
     * ---------------------------------------------------------------- */

    // Who is online. Everyone signed in may look; you may only publish yourself.
    match /presence/{key} {
      allow read: if hasSession();
      allow create, update: if hasSession() && request.resource.data.name.lower() == myKey();
      allow delete: if hasSession() && resource.data.name.lower() == myKey();
    }

    // Invitations are visible to the two people named in them and no one else.
    match /chatInvites/{inviteId} {
      allow read, delete: if hasSession()
        && (resource.data.from.lower() == myKey() || resource.data.to.lower() == myKey());
      allow create: if hasSession() && request.resource.data.from.lower() == myKey();
      // Either side may answer; neither may rewrite who it is from or to
      allow update: if hasSession()
        && (resource.data.from.lower() == myKey() || resource.data.to.lower() == myKey())
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to;
    }

    /* ---------------------------------------------------------------- *
     * Pair rooms
     * ---------------------------------------------------------------- */

    /*
     * MAIN-ROOM predates pairing and has no participant list. It stays open to
     * anyone signed in so the one-off migration button can copy it across;
     * remove this exception once everyone has moved their history over.
     */
    function isLegacyRoom(roomId) {
      return roomId == 'MAIN-ROOM';
    }

    /*
     * Membership of a pair room.
     *
     * Names are case-insensitive, but a rule cannot lowercase the entries of a
     * list — so rooms carry a lowercased copy of the pair and that is what is
     * checked. Rooms written before that field existed fall back to the
     * as-typed names.
     */
    function isIn(room) {
      return ('participantKeys' in room)
        ? myKey() in room.participantKeys
        : me() in room.participants;
    }

    function inRoom(roomId) {
      return isLegacyRoom(roomId)
        || isIn(get(/databases/$(database)/documents/rooms/$(roomId)).data);
    }

    match /rooms/{roomId} {
      /*
       * `get` and `list` are split on purpose.
       *
       * A single lookup has to tolerate a room that does not exist yet — the
       * app looks before it creates, and a denied lookup surfaces as an error
       * rather than as "not there". But that same `resource == null` clause is
       * trivially true while a query is being authorised, which would let
       * anyone list every room in the database. Queries therefore get their own
       * rule, evaluated against each document they would return.
       */
      allow get: if hasSession()
        && (resource == null
            || isLegacyRoom(roomId)
            || !('participants' in resource.data)
            || isIn(resource.data));

      allow list: if hasSession()
        && resource != null
        && ('participants' in resource.data)
        && isIn(resource.data);

      // A room may only be created with yourself in it
      allow create: if hasSession()
        && (isLegacyRoom(roomId) || isIn(request.resource.data));

      // The participant list is fixed once the pair exists
      allow update: if hasSession()
        && (isLegacyRoom(roomId) || isIn(resource.data))
        && (isLegacyRoom(roomId)
            || !('participants' in resource.data)
            || request.resource.data.participants == resource.data.participants);

      // Deletion stays available so the admin restore can start from a clean slate
      allow delete: if hasSession() && (isLegacyRoom(roomId) || isIn(resource.data));

      // Chat history
      match /messages/{messageId} {
        allow read, write: if hasSession() && inRoom(roomId);
      }

      // Played-question log: drives replay filtering and activity counts
      match /rounds/{roundId} {
        allow read, write: if hasSession() && inRoom(roomId);
      }

      // This pair's own question library
      match /faqs/{faqId} {
        allow read, write: if hasSession() && inRoom(roomId);
      }
    }

    /* ---------------------------------------------------------------- *
     * Everything else
     * ---------------------------------------------------------------- */

    // Per-person display preferences, keyed by the name used to sign in.
    match /userPrefs/{key} {
      allow read: if hasSession();
      allow write: if hasSession() && myKey() == key;
    }

    /*
     * The old shared library and its categories. Questions now live under each
     * room; these remain readable so the migration button can copy them.
     */
    match /faqs/{faqId} {
      allow read, write: if hasSession();
    }

    match /categories/{categoryId} {
      allow read, write: if hasSession();
    }

    // Anything not listed above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
