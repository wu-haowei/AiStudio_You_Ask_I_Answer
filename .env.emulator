# Loaded by `npm run dev:local` (vite --mode emulator).
# Points the app at the local Firestore/Auth emulator instead of the real project.
VITE_USE_EMULATOR=true

# The emulator keeps data separated by project id, so this has to match the id
# `npm run emulators` starts with — otherwise the app writes into one namespace
# while the emulator UI shows another, and the UI looks empty.
#
# The `demo-` prefix is Firebase's convention for an emulator-only project: the
# SDK refuses to reach production with it, which is a useful second safety net.
VITE_FIREBASE_PROJECT_ID=demo-youaskianswer
